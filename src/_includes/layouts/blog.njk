---
layout: index
---
<div class="main-container">
<script src="/javascript/mylikebutton.js"></script>

<article class="blog-post">
<p style="text-align: center;">
  <a href="/blog"><i class="bi bi-arrow-left-short"></i> back to posts</a>
</p>
    <h1>{{ title }}</h1>
    <i class="bi bi-calendar-heart"></i> <time datetime="{{ page.date | dateIso }}">{{ page.date | dateReadable }}</time> | 
    {% if tags %}
    {% for tag in tags %}
      {% if tag != "blog" and tag != "posts" %}
        <a href="/blog/tags/{{ tag | slug }}/">#{{ tag }}</a>{% if not loop.last %}, {% endif %}
      {% endif %}
    {% endfor %}

  {% endif %}

  

  <div class="blog-content">
    {% set tocHtml = content | toc %}
{% if tocHtml %}
    <h2>Table of Contents</h2>
    {{ tocHtml | safe }}
{% endif %}

    {{ content | safe }}
  </div>
---
<br><br>
<!-- Google Form Like Button -->
<form class="mylikebutton">
  🤍
</form>
<!--Comment Box-->
<div id="c_widget"></div>
<script src="/javascript/comment-widget.js"></script>
</article>

    {% set previousPost = collections.blog | getPreviousCollectionItem(page) %}
    {% if previousPost %}
      <a href="{{ previousPost.url }}"><i class="bi bi-arrow-left-short"></i> {{ previousPost.data.title }}</a>
    {% endif %}
|
    {% set nextPost = collections.blog | getNextCollectionItem(page) %}
    {% if nextPost %}
      <a href="{{ nextPost.url }}">{{ nextPost.data.title }} <i class="bi bi-arrow-right-short"></i></a>
    {% endif %}
</div>