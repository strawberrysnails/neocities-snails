<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="/images/favicon.gif" type="image/gif">
    <title>{{ title or "snails.town" }}</title>

    <link
      rel="alternate"
      type="application/rss+xml"
      title="Blog RSS"
      href="/feed.xml"
    />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Updates RSS"
      href="/updates/feed.xml"
    />

    <link rel="stylesheet" href="/css/style.css" type="text/css"/>
    <link rel="stylesheet" href="/css/fonts.css" type="text/css"/>
    <link rel="stylesheet" href="/css/bootstrap-icons.css" type="text/css"/>

    {% if page.url == "/" %}
      <link rel="stylesheet" href="/css/index.css" type="text/css"/>
    {% elif page.url.startsWith("/blog") %}
      <link rel="stylesheet" href="/css/blog.css" type="text/css"/>
    {% elif page.url.startsWith("/library") %}
      <link rel="stylesheet" href="/css/library.css" type="text/css"/>
          {% elif page.url.startsWith("/exhibits") %}
      <link rel="stylesheet" href="/css/museum.css" type="text/css"/>
      {% elif page.url.startsWith("/photogrid") %}
      <link rel="stylesheet" href="/css/photogrid.css" type="text/css"/>
      {% elif page.url.startsWith("/toybox") %}
      <link rel="stylesheet" href="/css/toybox.css" type="text/css"/>
          {% elif page.url.startsWith("/bedroom") %}
      <link rel="stylesheet" href="/css/bedroom.css" type="text/css"/>
       {% elif page.url.startsWith("/medialog") %}
      <link rel="stylesheet" href="/css/medialog.css" type="text/css"/>
    {% endif %}
    

  {# Render extra head content from frontmatter #}
  {{ head_extra | safe }}

  </head>

  <body>
    <div id="skipnav"><a href="#main-content">Skip to main content</a></div>
    {{ content | safe }}

    <script src="/javascript/main.js?nocache={{ nocache }}"></script>
    <script src="/javascript/jquery.min.js"></script>
    <script src="/javascript/jquery.style-my-tooltips.js"></script>
    <script>
    (function($){
        $(document).ready(function(){
            $("[title]").style_my_tooltips();
        });
    })(jQuery);
</script>

    <!-- BLOG IMAGE MODAL -->
<div id="photoModal">
  <span id="closeModal">&times;</span>
  <div class="modal-content">
    <div class="modal-inner">
      <button id="prevPhoto" class="modal-nav">‹</button>
      <img id="modalImage" src="" />
      <button id="nextPhoto" class="modal-nav">›</button>
    </div>
    <div id="modalCaption"></div>
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', () => {
  const modal = document.getElementById('photoModal');
  const modalImg = document.getElementById('modalImage');
  const caption = document.getElementById('modalCaption');
  const prevBtn = document.getElementById('prevPhoto');
  const nextBtn = document.getElementById('nextPhoto');
  const closeBtn = document.getElementById('closeModal');
  let photos = Array.from(document.querySelectorAll('.blog-img'));
  let currentIndex = 0;

  function openModal(index) {
    const img = photos[index];
    if (!img) return;
    modalImg.src = img.src;
    caption.textContent = img.alt || '';
    modal.style.display = "block";
    currentIndex = index;
  }

  function closeModal() {
    modal.style.display = "none";
  }

  // Delegated click handler on blog-content
  const blogContent = document.querySelector('.blog-content');
  if (blogContent) {
    blogContent.addEventListener('click', e => {
      if (!e.target.classList.contains('blog-img')) return;
      // Re-fetch photos in case new ones were added dynamically
      photos = Array.from(document.querySelectorAll('.blog-img'));
      const index = photos.indexOf(e.target);
      if (index !== -1) openModal(index);
    });
  }

  closeBtn.addEventListener('click', closeModal);

  // Click outside modal-inner closes modal
  modal.addEventListener('click', e => {
    if (!document.querySelector('.modal-inner').contains(e.target)) closeModal();
  });

  prevBtn.addEventListener('click', () => {
    openModal((currentIndex - 1 + photos.length) % photos.length);
  });

  nextBtn.addEventListener('click', () => {
    openModal((currentIndex + 1) % photos.length);
  });

  // Keyboard navigation
  document.addEventListener('keydown', e => {
    if (modal.style.display !== "block") return;
    if (e.key === "Escape") closeModal();
    else if (e.key === "ArrowLeft") openModal((currentIndex - 1 + photos.length) % photos.length);
    else if (e.key === "ArrowRight") openModal((currentIndex + 1) % photos.length);
  });
});
</script>

  </body>
</html>
